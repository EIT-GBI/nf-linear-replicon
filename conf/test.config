// ---------------------------------------------------------------------------
// Minimal end-to-end test profile
// ---------------------------------------------------------------------------
// Runs the whole pipeline on the tiny dataset in assets/test-data: a 75 kb
// three-contig "genome", a 6 kb construct, and three samples -- two libraries
// of a clone carrying ONE planted integration, plus a control that carries the
// construct and no integration. What was planted is written down in
// assets/test-data/truth.json; scripts/make_test_data.py rebuilds it all from
// a fixed seed.
//
//   nextflow run . -profile test,docker
//   nextflow run . -profile test,local     # minimap2/samtools/python3 from $PATH
// ---------------------------------------------------------------------------

params {
    samplesheet   = "${projectDir}/assets/samplesheet_test.csv"
    reference_dir = "${projectDir}/assets/test-data/references"
    outdir        = 'results-test'

    architecture {
        enabled = true
    }
}

process {
    resourceLimits = [ cpus: 2, memory: 6.GB, time: 1.h ]
    cpus   = 2
    memory = 3.GB
}
