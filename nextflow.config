// ---------------------------------------------------------------------------
// nf-linear-replicon - where a linear replicon construct integrated, from ONT reads
// ---------------------------------------------------------------------------

manifest {
    name            = 'nf-linear-replicon'
    author          = 'EIT Generative Biology Institute'
    homePage        = 'https://github.com/EIT-GBI/nf-linear-replicon'
    description     = 'Linear replicon integration sites in a host genome, from ONT reads'
    mainScript      = 'main.nf'
    version         = '1.0.0'
    nextflowVersion = '!>=25.04.0'
    // The tool modules are git submodules. Without this, `nextflow run
    // EIT-GBI/nf-linear-replicon -r vX.Y.Z` checks out an empty modules/ and
    // every include fails.
    recurseSubmodules = true
}

// ---------------------------------------------------------------------------
// Parameters
// ---------------------------------------------------------------------------
// Defaults for every parameter main.nf reads, so the pipeline starts up with a
// clear error about what is missing rather than a Groovy "No such property".
params {
    // Input
    samplesheet   = null    // sample,readset,barcode,reference_genome,additional_reference,fastq_path
    reference_dir = null    // holds the genome and construct FASTAs the samplesheet names

    // Where published results go
    outdir        = 'results'

    // minimap2 preset for the reads
    preset        = 'map-ont'

    alignment {
        // 'dorado' (default) or 'minimap2'.
        //
        // dorado aligner is minimap2 inside, and it reads unaligned BAM
        // directly -- so a bam_pass run needs no FASTQ round trip and the
        // MM/ML modified-base tags are never touched. It takes one reads file,
        // which PREPARE_READS has already seen to.
        //
        // minimap2 is the alternative, and the path the explicit flags below
        // are written for (-Y, --secondary=no, --MD). It cannot read BAM, so
        // PREPARE_READS decodes to FASTQ for it.
        tool = 'dorado'
    }

    // How the construct contig is told apart from the host's. Everything
    // downstream identifies the construct as "the contig that is not a host
    // accession", so a construct whose name starts with one of these is a hard
    // error in BUILD_REFERENCE rather than a silent zero-junction run.
    // CHO/RefSeq assemblies use NC_ (chromosomes) and NW_ (scaffolds).
    host_contig_prefixes = ['NC_', 'NW_']

    // Per-sample junction calling (JUNCTION_POSITIONS)
    junction {
        // The main false-positive filter: reads joined by accident in library
        // prep, and the short stretches the construct shares with the genome,
        // both leave one SHORT side. Requiring length on both sides removes
        // most false positives on its own.
        min_genome_bp         = 500
        min_construct_bp      = 500
        group_within          = 100   // Nanopore breakpoints wobble a few bases
        min_mapping_quality   = 60    // below this is repetitive sequence, not trustworthy
        min_reads_to_shortlist = 1    // 1 keeps the single-read background you judge against
        max_rows_to_print     = 60    // the file always holds all of them
    }

    // Cross-sample recurrence (JUNCTION_MATRIX)
    matrix {
        cluster_tolerance = 2000      // breakpoints within this distance are one locus
        min_total_reads   = 2         // drop clusters with fewer reads than this in total
    }

    // Optional per-read architecture report
    architecture {
        enabled = false
    }

    // Helper scripts, resolved relative to projectDir
    scripts {
        py_architecture = './modules/local/read_architecture/architecture.py'
    }
}

// ---------------------------------------------------------------------------
// Module containers
// ---------------------------------------------------------------------------
// Each nf-mod-* module declares the image it was built from, in its own
// conf/module.config, pinned to that module's release version. Nextflow does
// not read a submodule's config on its own, so each is included explicitly.
//
// These come before `profiles`, so -profile dev can override them.
includeConfig 'modules/samtools/conf/module.config'
includeConfig 'modules/minimap2/conf/module.config'

// ---------------------------------------------------------------------------
// Process defaults
// ---------------------------------------------------------------------------
process {
    // Retry only on failures a fresh attempt with more resources can plausibly
    // fix: 104 = connection reset while staging, 130..145 = killed by a signal
    // (137 OOM, 140 SLURM time limit, 143 SIGTERM). Anything else is a real
    // error in the tool or the data, and 'finish' lets running tasks complete
    // so you get a clean log instead of a half-cancelled run.
    errorStrategy = { (task.exitStatus in (130..145) || task.exitStatus == 104) ? 'retry' : 'finish' }
    maxRetries    = 3

    cpus   = 2
    memory = 4.GB

    withName: 'MINIMAP2_.*' {
        // -Y  keep split pieces soft-clipped, so the sequence either side of a
        //     junction stays in the record. This is what makes the construct
        //     and genome halves of one read both visible.
        // --secondary=no  one alignment per piece; the SA tag does the pairing
        // -y  carry the MM/ML modified-base tags from the FASTQ comment into the BAM
        ext.args = '-Y -L --MD --secondary=no -K 100M -y'
        cpus     = 8
        memory   = { 24.GB * task.attempt }
    }
    withName: 'SAMTOOLS_.*' {
        ext.args = ''
        cpus     = 4
    }

    // Local processes. The images are the same ones the module submodules pin
    // (see modules.versions); they are named again here because a local module
    // has no conf/module.config of its own.
    withName: 'PREPARE_READS' {
        container = 'ghcr.io/eit-gbi/nf-mod-samtools:v1.2.0'
        // Only used on the minimap2 route, where the BAMs are decoded:
        //   -F 0x900  drop secondary/supplementary, in case the bam_pass BAM is
        //             already aligned -- otherwise those reads come through twice
        //   -T MM,ML  carry the modified-base tags across; minimap2 -y picks them up
        ext.args  = '-F 0x900 -T MM,ML'
        cpus      = 4
    }
    withName: 'EXTRACT_CONSTRUCT_READS|JUNCTION_.*' {
        container = 'ghcr.io/eit-gbi/nf-mod-samtools:v1.2.0'
        cpus      = 4
    }
    withName: 'BUILD_REFERENCE' {
        container = 'ghcr.io/eit-gbi/nf-mod-samtools:v1.2.0'
        cpus      = 1
        memory    = { 4.GB * task.attempt }
    }
    withName: 'CONSTRUCT_HOMOLOGY' {
        container = 'ghcr.io/eit-gbi/nf-mod-minimap2:v1.0.0'
        ext.args  = '-c -x asm20'
        cpus      = 8
        memory    = { 16.GB * task.attempt }
    }
    withName: 'DORADO_.*' {
        container = 'ghcr.io/eit-gbi/nf-mod-dorado:v1.0.0'
        // `dorado aligner` exposes few minimap2 options. If your dorado build
        // takes --mm2-opts, this is where the minimap2 route's flags would go:
        //   ext.args = '--mm2-opts "-Y -L --MD --secondary=no"'
        // They are not required: the junction steps filter with -F 0x104, which
        // drops secondary alignments whatever the aligner emitted.
        ext.args  = ''
        cpus      = 8
        memory    = { 24.GB * task.attempt }
    }
    withName: 'READ_ARCHITECTURE' {
        // Runs the bundled python script; no tool container needed
        container = 'python:3.12-slim'
        cpus      = 1
    }
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
// These come after the process defaults: when several withName selectors match
// a process, the last one in the file wins, so a profile's resources only take
// effect if it is declared later.
profiles {
    // Test against unreleased module changes: the module configs pin an image
    // version that only exists once that module is released, so point every
    // module back at :latest.
    dev {
        process {
            withName: 'SAMTOOLS_.*|PREPARE_READS|EXTRACT_CONSTRUCT_READS|JUNCTION_.*|BUILD_REFERENCE' {
                container = 'ghcr.io/eit-gbi/nf-mod-samtools:latest'
            }
            withName: 'MINIMAP2_.*|CONSTRUCT_HOMOLOGY' {
                container = 'ghcr.io/eit-gbi/nf-mod-minimap2:latest'
            }
        }
    }
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        apptainer.enabled = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        docker.enabled       = false
    }
    // No containers at all: minimap2, samtools and python3 come from $PATH.
    local {
        docker.enabled    = false
        apptainer.enabled = false
    }
    cluster {
        docker.enabled       = false
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = '/mnt/lustre/containers/.staging/nf/cache/'
        process.executor     = 'slurm'
        process.queue        = 'cpu'
        process {
            // Memory on the aligner is set by the minimap2 index of the host
            // genome (~6-8 GB resident for CHO), not by the reads.
            withName: 'MINIMAP2_.*'             { cpus = 16; memory = { 32.GB * task.attempt }; time = '24 h' }
            // On the cpu queue on purpose: `dorado aligner` is minimap2 and
            // does not use the GPU, unlike basecalling. Memory is set by the
            // index of the host genome (~8 GB resident for CHO), not the reads.
            withName: 'DORADO_.*'               { cpus = 16; memory = { 32.GB * task.attempt }; time = '24 h' }
            withName: 'BUILD_REFERENCE'         { cpus = 1;  memory = { 8.GB  * task.attempt }; time = '2 h'  }
            withName: 'CONSTRUCT_HOMOLOGY'      { cpus = 8;  memory = { 32.GB * task.attempt }; time = '2 h'  }
            withName: 'SAMTOOLS_.*'             { cpus = 8;  memory = { 16.GB * task.attempt }; time = '12 h' }
            withName: 'PREPARE_READS'           { cpus = 4;  memory = { 8.GB  * task.attempt }; time = '12 h' }
            withName: 'EXTRACT_CONSTRUCT_READS' { cpus = 4;  memory = { 16.GB * task.attempt }; time = '12 h' }
            withName: 'JUNCTION_.*'             { cpus = 2;  memory = { 8.GB  * task.attempt }; time = '4 h'  }
            withName: 'READ_ARCHITECTURE'       { cpus = 1;  memory = { 8.GB  * task.attempt }; time = '4 h'  }
        }
    }
    test { includeConfig 'conf/test.config' }
}

// ---------------------------------------------------------------------------
// Workflow outputs
// ---------------------------------------------------------------------------
// Nextflow does not wire params.outdir to the output directory automatically,
// so bridge it explicitly. This must come *after* the profiles block: profiles
// may override params.outdir, and this assignment reads whatever value is
// current at the point it runs. -output-dir / -o on the CLI overrides it.
outputDir = params.outdir

workflow.output.mode = 'link'
