config {
    testsDir "tests"
    workDir ".nf-test"
    configFile "nextflow.config"

    // 'local' means no containers: minimap2, samtools and python3 come from
    // $PATH, which is how this runs on a laptop. CI swaps the engine in with
    //     nf-test test --profile test,docker
    profile "test,local"
}
